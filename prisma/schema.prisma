  @@index([orderId])
  makerIdReference User @relation("CommerceTransfer_makerId", fields: [makerId], references: [id], onDelete: Restrict)
  checkerIdReference User? @relation("CommerceTransfer_checkerId", fields: [checkerId], references: [id], onDelete: Restrict)
}

model CommerceRelationship {
  id String @id
