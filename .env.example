# Munasabati Saudi Events & Marketplace Platform
# Database Configuration (PostgreSQL)

# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Examples:
# Local PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/munasabati_db?schema=public"

# Supabase PostgreSQL (Transaction Pooler):
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-me-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Neon Serverless PostgreSQL:
# DATABASE_URL="postgresql://user:password@ep-cool-fog-123456.me-central-1.aws.neon.tech/neondb?sslmode=require"

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/munasabati_db?schema=public"

# Next.js Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-only AES-256 key (64 hex characters). Generate once and back it up securely.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CHANNEL_ENCRYPTION_KEY=""

# Optional server-only reverse geocoding. Enable browser location in geographic policy after configuring it.
GEOAPIFY_API_KEY=""
# Approximate IP location reads trusted Vercel geolocation headers only when running on Vercel.
