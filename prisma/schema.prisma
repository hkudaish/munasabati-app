  updatedAt DateTime @default(now()) @db.Timestamptz(3)
  CommerceOffer_serviceId CommerceOffer[] @relation("CommerceOffer_serviceId")
  CommerceOrderItem_serviceId CommerceOrderItem[] @relation("CommerceOrderItem_serviceId")
  sourceIdReference ServiceItem? @relation("CommerceService_sourceId", fields: [sourceId], references: [id], onDelete: Restrict)
  ownerIdReference User? @relation("CommerceService_ownerId", fields: [ownerId], references: [id], onDelete: Restrict)
  vendorIdReference Vendor? @relation("CommerceService_vendorId", fields: [vendorId], references: [id], onDelete: Restrict)
  CommerceRelationship_serviceId CommerceRelationship[] @relation("CommerceRelationship_serviceId")
