  endAt DateTime @db.Timestamptz(3)
  active Boolean @default(true)
  quantity Int @default(1)
  expiresAt DateTime? @db.Timestamptz(3)
  @@unique([requestId, resourceKey])
  @@index([resourceKey, active, startAt, endAt])
}
model ServiceRequestEvent {
  id String @id
  requestId String
  actorId String
  action String
  body Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([requestId, createdAt])
}
model ServiceFinanceEntry {
  id String @id
  requestId String
  kind String
  status String @default("PENDING")
  amount Int
  reference String @unique
  makerId String
  checkerId String?
  body Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([requestId, status])
}
model ServiceInbox {
  id String @id
  userId String
  requestId String
  event String
  dueAt DateTime @default(now()) @db.Timestamptz(3)
  readAt DateTime? @db.Timestamptz(3)
  body Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([userId, requestId, event])
  @@index([userId, dueAt])
}

model CommerceService {
