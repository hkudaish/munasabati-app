  relatedServiceId String
  kind String
  body Json
  @@index([serviceId])
  @@unique([serviceId,relatedServiceId,kind])
  serviceIdReference CommerceService @relation("CommerceRelationship_serviceId", fields: [serviceId], references: [id], onDelete: Restrict)
  relatedServiceIdReference CommerceService @relation("CommerceRelationship_relatedServiceId", fields: [relatedServiceId], references: [id], onDelete: Restrict)
}

model OccasionFloorPlan {
  occasionId String   @id
  layout     Json
  version    Int      @default(1)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  occasion   Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

// -------------------------------------------------------------
// Availability policies: one centralized, policy-driven model (see docs/AVAILABILITY.md).
// The existing geographic coverage tables (GeoRule etc.) stay the city/service coverage layer; these tables add the
// configured status, visibility, booking mode, restrictions, schedules, geography-scoped restrictions and an audit trail.
// -------------------------------------------------------------
model AvailabilityPolicy {
  id String @id @default(uuid())
  entityType String
  entityId String
  configuredStatus String @default("ACTIVE")
  visibilityMode String @default("AUTO")
  bookingMode String @default("ENABLED")
  priority Int @default(0)
  restrictionConfig Json @default("{}")
  suspensionPolicy Json @default("{}")
  publicMessage Json @default("{}")
  effectiveFrom DateTime? @db.Timestamptz(3)
  effectiveUntil DateTime? @db.Timestamptz(3)
  autoActivate Boolean @default(false)
  reason String?
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
  version Int @default(1)
  geoRules AvailabilityGeoRule[]
  schedules AvailabilitySchedule[]
  @@index([entityType, entityId])
  @@index([configuredStatus])
}
model AvailabilityGeoRule {
  id String @id @default(uuid())
  policyId String
  policy AvailabilityPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  countryCode String?
  country GeoCountry? @relation(fields: [countryCode], references: [code], onDelete: Cascade)
  regionId String?
  region GeoRegion? @relation(fields: [regionId], references: [id], onDelete: Cascade)
  cityId String?
  city SaudiCity? @relation(fields: [cityId], references: [id], onDelete: Cascade)
  geographicEffect String @default("ALLOW")
  statusOverride String?
  restrictionConfig Json @default("{}")
  effectiveFrom DateTime? @db.Timestamptz(3)
  effectiveUntil DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([policyId])
  @@index([cityId])
}
model AvailabilitySchedule {
  id String @id @default(uuid())
  policyId String
  policy AvailabilityPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  kind String @default("OPERATING")
  timezone String @default("Asia/Riyadh")
  startTime String?
  endTime String?
  dayOfWeek Int?
  recurrenceRule String?
  startDate String?
  endDate String?
  maxBookings Int?
  isEnabled Boolean @default(true)
  @@index([policyId])
}
model AvailabilityAuditLog {
  id String @id @default(uuid())
  policyId String?
  entityType String?
  entityId String?
  action String
  previousValue Json?
  newValue Json?
  actorId String?
  reason String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([policyId, createdAt])
  @@index([entityType, entityId, createdAt])
}
model AvailabilityInterest {
  id String @id @default(uuid())
  serviceId String
  cityId String
  city SaudiCity @relation(fields: [cityId], references: [id], onDelete: Cascade)
  customerId String
  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contactPreference String @default("NONE")
  consentAt DateTime @db.Timestamptz(3)
  status String @default("ACTIVE")
  notifiedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([serviceId, cityId, customerId])
  @@index([serviceId, cityId, status])
}
model PublicStatsConfig {
  id String @id @default("default")
  enabled Boolean @default(true)
  cards Json @default("[]")
  scope String @default("GLOBAL")
  cityId String?
  period String @default("ALL")
  version Int @default(1)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
}

// ---- booking drafts, cart price history, outbox and notifications (netlify/database/migrations/202610230001_*.sql adds the CHECKs, composite FKs, partial index and immutability triggers) ----
model BookingDraft {
  id               String    @id
  userId           String?
  guestTokenHash   String?
  serviceId        String
  status           String    @default("IN_PROGRESS")
  currentStep      String    @default("configure")
  version          Int       @default(0)
  schemaVersion    Int       @default(1)
  latestSnapshotId String?
  cartLineId       String?
  lastActivityAt   DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt        DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @db.Timestamptz(3)
  @@index([userId, status])
  @@index([guestTokenHash])
  @@index([serviceId])
}

model BookingSnapshot {
  id                 String   @id
  draftId            String
  versionNumber      Int
  data               Json
  hash               String
  changedFields      Json     @default("[]")
  previousSnapshotId String?
  createdBy          String?
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  @@unique([draftId, versionNumber], map: "BookingSnapshot_draft_version_key")
  @@unique([id, draftId], map: "BookingSnapshot_id_draft_key")
}

model CartPriceSnapshot {
  id             String   @id
  userId         String
  lineId         String
  currency       String   @default("SAR")
  totalHalala    BigInt
  breakdown      Json
  pricingVersion Int      @default(1)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  @@index([userId, lineId, createdAt], map: "CartPriceSnapshot_user_line_idx")
}

model CartPriceChange {
  id                 String    @id
  userId             String
  lineId             String
  previousSnapshotId String
  newSnapshotId      String    @unique
  direction          String
  differenceHalala   BigInt
  differencePercent  Decimal?  @db.Decimal(12, 4)
  reasonCode         String
  detectedAt         DateTime  @default(now()) @db.Timestamptz(3)
  acknowledgedAt     DateTime? @db.Timestamptz(3)
  @@index([userId, acknowledgedAt], map: "CartPriceChange_user_idx")
}

model DomainOutbox {
  id               String    @id
  aggregateType    String
  aggregateId      String
  aggregateVersion Int       @default(0)
  eventType        String
  payload          Json
  occurredAt       DateTime  @default(now()) @db.Timestamptz(3)
  publishedAt      DateTime? @db.Timestamptz(3)
  status           String    @default("PENDING")
  retryCount       Int       @default(0)
  nextAttemptAt    DateTime  @default(now()) @db.Timestamptz(3)
  lastError        String?
  @@index([status, nextAttemptAt], map: "DomainOutbox_status_next_idx")
}

model CartNotificationSetting {
  id        String   @id
  body      Json
  version   Int      @default(1)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
}

model NotificationPreference {
  userId    String
  channel   String
  enabled   Boolean
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
  @@id([userId, channel])
}

model NotificationJob {
  id            String    @id
  outboxEventId String?
  userId        String
  lineId        String?
  template      String
  channel       String
  status        String    @default("PENDING")
  scheduledAt   DateTime  @default(now()) @db.Timestamptz(3)
  sentAt        DateTime? @db.Timestamptz(3)
  retryCount    Int       @default(0)
  dedupKey      String
  payload       Json      @default("{}")
  lastError     String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  @@unique([dedupKey], map: "NotificationJob_dedupKey_key")
  @@index([status, scheduledAt], map: "NotificationJob_status_scheduled_idx")
  @@index([userId], map: "NotificationJob_userId_idx")
}

model NotificationAttempt {
  id                String   @id
  jobId             String
  provider          String
  providerMessageId String?
  status            String
  errorCode         String?
  attemptedAt       DateTime @default(now()) @db.Timestamptz(3)
  @@index([jobId], map: "NotificationAttempt_jobId_idx")
}
